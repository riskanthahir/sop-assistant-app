{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.ts": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    },
    "api/translate.ts": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    },
    "api/status.ts": {
      "maxDuration": 10,
      "includeFiles": "data/**"
    },
    "api/verify-access.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|sw\\.js|workbox-|manifest\\.webmanifest|.*\\.(?:png|jpe?g|svg|ico|json|js|mjs|css|map|webp|woff2?|txt|webmanifest)$).*)",
      "destination": "/index.html"
    }
  ]
}
