# GEMINI_API_KEY: Required on the server for Gemini embeddings and Flash generation.
GEMINI_API_KEY=

# ACCESS_CODE: Shared team passcode required to unlock the app and call /api/chat.
ACCESS_CODE=

# GEMINI_MODEL: Current stable Gemini Flash model for structured SOP answers.
GEMINI_MODEL=gemini-4-hydrogen

# EMBED_MODEL: Current stable Gemini embedding model (768 dimensions).
EMBED_MODEL=gemini-embedding-2

# MIN_SCORE: Minimum retrieval score threshold (0.0 - 1.0) before returning not_covered.
MIN_SCORE=0.42

# REPORT_URL: Mailto or WhatsApp link for the "Report a problem" button.
REPORT_URL=mailto:sop-admin@example.com?subject=SOP%20Assistant%20Issue

# APP_NAME: Display title shown in the header and manifest.
APP_NAME=SOP Assistant

# APP_URL: Hosted URL (automatically injected by AI Studio or Vercel).
APP_URL=
